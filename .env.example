# === Core ===
ENV=dev
POLL_INTERVAL_SECONDS=10

# === LLM / RAG ===
OPENAI_API_KEY=sk-...
EMBEDDINGS_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
VECTOR_BACKEND=chroma  # or faiss

# === DB ===
DB_URL=sqlite:///dev.db
# DB_URL=postgresql+psycopg://user:pass@localhost:5432/incident_ai

# === Logs (S3 optional) ===
LOGS_MODE=local        # local | s3
LOGS_LOCAL_ROOT=app/logs
S3_BUCKET=your-bucket
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...

# === CloudWatch (optional real) ===
USE_REAL_CLOUDWATCH=false
CLOUDWATCH_LOG_GROUP=/aws/lambda/demo

# === MIND incident memory (optional, off by default) ===
MIND_ENABLED=false
MIND_API_KEY=mind_...              # m-i-n-d.ai -> Settings -> Developer -> API Keys
MIND_BASE_URL=https://www.m-i-n-d.ai
MIND_QUERY_MODE=mix                # mix | hybrid | global | local | naive
MIND_TIMEOUT_SECONDS=4
MIND_MAX_HISTORY=3
MIND_FOLDER=OnCallAI Incidents
